{
  "compilerOptions": {
    "target": "ES2025",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["node", "ws"],
    "declaration": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "incremental": true,
    "composite": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "vitest.config.ts", "rolldown.config.ts", "rolldown.sea.config.ts", "package.json"],
  "exclude": ["node_modules", "dist"]
}
